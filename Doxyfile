TOC_INCLUDE_HEADINGS = 5
DISABLE_INDEX = NO
GENERATE_TREEVIEW = YES
HTML_DYNAMIC_MENUS = YES
HTML_DYNAMIC_SECTIONS = YES
FULL_PATH_NAMES = YES
STRIP_FROM_PATH = .
LAYOUT_FILE =
HTML_HEADER =
HTML_FOOTER =
HTML_EXTRA_STYLESHEET =
HTML_EXTRA_FILES =
CLASS_DIAGRAMS = YES
HIDE_FRIEND_COMPOUNDS = NO
HIDE_IN_BODY_DOCS = NO
